{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|vendor/|css/|js/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}

